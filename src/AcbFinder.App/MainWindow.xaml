<Window x:Class="AcbFinder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AcbFinder.App"
        Title="SongForPrism ACB/AWB Finder" Height="560" Width="760"
        MinHeight="440" MinWidth="600"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        Foreground="#E8E8EE">
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <Window.Background>
        <RadialGradientBrush GradientOrigin="0.85,-0.1" Center="0.85,-0.1" RadiusX="1.1" RadiusY="0.9">
            <GradientStop Color="#13202A" Offset="0" />
            <GradientStop Color="#0B0B10" Offset="1" />
        </RadialGradientBrush>
    </Window.Background>

    <Window.Resources>
        <Color x:Key="CardColor">#16161C</Color>
        <Color x:Key="CardHoverColor">#222430</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="#5EE0C0" />
        <SolidColorBrush x:Key="HairlineBrush" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="DimBrush" Color="#8A8A96" />

        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E8E8EE" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="12" BorderThickness="1"
                                BorderBrush="{StaticResource HairlineBrush}"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource CardColor}" />
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Bd"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="{StaticResource CardHoverColor}" Duration="0:0:0.15">
                                                <ColorAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Bd"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="{StaticResource CardColor}" Duration="0:0:0.3">
                                                <ColorAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#38FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#E8E8EE" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Background" Value="#101014" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="11" BorderThickness="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#665EE0C0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="3" Background="#1A1A22" />
                            <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#3FBFA6" Offset="0" />
                                        <GradientStop Color="#5EE0C0" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28,24,28,24" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="EntryShift" Y="14" />
        </Grid.RenderTransform>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.45" />
                        <DoubleAnimation Storyboard.TargetName="EntryShift" Storyboard.TargetProperty="Y"
                                         From="14" To="0" Duration="0:0:0.45">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,0,20">
            <TextBlock Text="ACB / AWB Finder" FontSize="24" FontWeight="SemiBold" />
        </StackPanel>

        <DockPanel Grid.Row="1">
            <Button DockPanel.Dock="Right" Content="Browse" Style="{StaticResource CardButton}"
                    Padding="20,9" Margin="10,0,0,0" Command="{Binding BrowseCommand}" />
            <TextBox Style="{StaticResource DarkTextBox}"
                     Text="{Binding GameFolder, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" />
        </DockPanel>

        <UniformGrid Grid.Row="2" Columns="4" Margin="0,14,0,14">
            <Button Style="{StaticResource CardButton}" Margin="0,0,10,0" Command="{Binding DecryptCommand}">
                <StackPanel>
                    <TextBlock Text="STEP 01" FontSize="9.5" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,3" />
                    <TextBlock Text="Decrypt" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource CardButton}" Margin="0,0,10,0" Command="{Binding ExtractAcbCommand}">
                <StackPanel>
                    <TextBlock Text="STEP 02" FontSize="9.5" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,3" />
                    <TextBlock Text="Extract ACB" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource CardButton}" Margin="0,0,10,0" Command="{Binding ExtractAwbCommand}">
                <StackPanel>
                    <TextBlock Text="STEP 03" FontSize="9.5" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,3" />
                    <TextBlock Text="Extract AWB" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource CardButton}" Command="{Binding CategorizeWavCommand}">
                <StackPanel>
                    <TextBlock Text="STEP 04" FontSize="9.5" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,3" />
                    <TextBlock Text="Categorize WAV" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
        </UniformGrid>

        <Border Grid.Row="3" CornerRadius="16" Background="#0AFFFFFF"
                BorderBrush="#14FFFFFF" BorderThickness="1" Padding="6">
            <Border CornerRadius="11" Background="#0E0E12">
                <TextBox x:Name="LogBox" Style="{StaticResource DarkTextBox}"
                         Text="{Binding LogText, Mode=OneWay}"
                         Background="Transparent" BorderThickness="0"
                         IsReadOnly="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Cascadia Mono, Consolas" FontSize="12"
                         Foreground="#B9B9C4"
                         TextChanged="LogBox_TextChanged" />
            </Border>
        </Border>

        <ProgressBar Grid.Row="4" Margin="2,16,2,0"
                     Value="{Binding ProgressValue, Mode=OneWay}"
                     Maximum="{Binding ProgressMax, Mode=OneWay}" />
    </Grid>
</Window>
